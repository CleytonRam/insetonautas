~ talk_to_nathan
Coco: Salve, fi. 🤙
Nathan: Oi divoooo!!
if State.apple_status == "has":
	Coco: Peguei lá. 👍
	- Dar pro Nathan
		set State.apple_status = "gave"
		Coco: Toma, fi.
		Nathan: Pisa menooos. [#happy]
		Coco: Tamo aí. 🤙
	- Ficar pra mim
		Coco: Sai fora, doidão.  [#shady]
		Nathan: Affs, que ódio... 🙄
elif State.apple_status == "gave":
	Nathan: Qualquer coisa vai avisando, miga. 💅 [#happy]
else:
	Nathan: Affs veyr, queria uma maçã. Tem uma árvore divônica ali do lado. 
	Coco: Vou pegar lá pra nóis...
=> END


~ pick_apple
Coco: Árvre.
do coco.look_down()
Coco: Chama 🔥
do coco.reach_up()
set State.apple_status = "has"
[wave amp=25 freq=5]Você pegou uma[color=#ff3f3f] MAÇÃ[/color].[/wave]
Coco: Vou entregar pro cabra lá.
=> END